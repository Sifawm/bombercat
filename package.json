{
  "name": "bombercat",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --build server/tsconfig.lib.json",
    "typecheck": "tsc --build server/tsconfig.json web/tsconfig.json",
    "test": "pnpm build && pnpm --filter @bombercat/server test",
    "server": "pnpm build && node server/dist/main.js",
    "web": "pnpm --filter @bombercat/web start",
    "export:web": "mkdir -p web/public/godot && godot --headless --path game --export-release Web ../web/public/godot/index.html",
    "addon": "cp web/node_modules/@porterkit/godot/addons/porter/porter.gd game/addons/porter/porter.gd",
    "build:web": "pnpm export:web && pnpm --filter @bombercat/web build",
    "start": "pnpm build && node server/dist/main.js"
  },
  "devDependencies": {
    "@swc/core": "^1.16.0",
    "@types/node": "^24.0.0",
    "typescript": "~6.0.3",
    "unplugin-swc": "^2.0.0",
    "vite": "^8.0.0",
    "vitest": "5.0.3"
  },
  "packageManager": "pnpm@11.18.0"
}
